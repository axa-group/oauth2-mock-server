{
  "name": "oauth2-mock-server",
  "version": "9.1.0",
  "description": "OAuth2 and OpenID Connect mock server for automated testing and development. OIDC-conformant, with real signed JWTs, JWKS, PKCE, and per-test response customization. Use as a CLI or JavaScript/TypeScript library.",
  "type": "module",
  "keywords": [
    "oauth",
    "oauth2",
    "mock",
    "fake",
    "stub",
    "oidc",
    "openid",
    "openid-connect",
    "mock-server",
    "oauth-mock",
    "oauth2-mock",
    "oidc-mock",
    "test",
    "testing",
    "test-server",
    "integration-testing",
    "e2e-testing",
    "pkce",
    "jwt",
    "jwk",
    "jwks",
    "access-token",
    "authorization-code",
    "typescript",
    "cli"
  ],
  "author": {
    "name": "Jorge Poveda",
    "email": "jorge.poveda@axa-assistance.es"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.12 || ^24 || ^26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axa-group/oauth2-mock-server.git"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "oauth2-mock-server": "dist/oauth2-mock-server.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE.md",
    "README.md",
    "dist/**/*.*"
  ],
  "scripts": {
    "build": "npx tsdown",
    "prelint": "tsc --noEmit",
    "lint": "eslint --cache --cache-location .cache/ src test --max-warnings 0",
    "prepack": "npm run build",
    "pretest": "npm run lint",
    "test": "vitest --run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "basic-auth": "^2.0.1",
    "is-plain-obj": "^4.1.0",
    "jose": "^6.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/basic-auth": "^1.1.8",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.2",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@types/node": "$@types/node"
  }
}
